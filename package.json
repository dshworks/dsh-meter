{
  "name": "@dshworks/dsh-meter",
  "description": "The DeepSeek time-of-use meter for dsh: what this session cost, which tariff is running, when it flips, and the account balance behind it — one line under the composer.",
  "version": "0.2.4",
  "license": "MIT",
  "homepage": "https://dsh.works/dsh-meter/",
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./core": "./lib/core.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "src",
    "scripts",
    "cordis.patch.yml",
    "llms.txt",
    "README.md",
    "README.zh.md",
    "LICENSE"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dshworks/dsh-meter.git"
  },
  "scripts": {
    "build": "node scripts/build-client.mjs && node scripts/build-site.mjs && node scripts/build-feed.mjs",
    "test": "node scripts/build-client.mjs --check && node scripts/build-site.mjs --check && node scripts/build-feed.mjs --check && vitest run",
    "verify:pricing": "node scripts/verify-pricing.mjs",
    "sync:pricing": "node scripts/apply-pricing.mjs && npm run build"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-runtime",
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-locale"
      ],
      "platform": "web"
    }
  },
  "keywords": [
    "deepseek",
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "cost",
    "pricing",
    "peak-offpeak",
    "time-of-use",
    "token-usage",
    "billing",
    "balance",
    "usage"
  ],
  "dependencies": {
    "@deepseek-ai/schemastery": "^3.18.1"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-session-projection": "^0.1.0-rc.6"
  },
  "devDependencies": {
    "vitest": "^3.2.4"
  },
  "engines": {
    "node": ">=20"
  }
}
